# Copy to ".env" and fill in. ".env" must never be committed (see .gitignore).
# Names map to appsettings.json: "__" is the section separator and these values override the file.

# --- Userbot (my.telegram.org) ---
UserbotConfig__ApiId=1234567
UserbotConfig__ApiHash=YOUR_API_HASH
UserbotConfig__PhoneNumber=+998901234567
# Only if the account has two-step verification (2FA); otherwise leave empty. Write "$" as "$$".
UserbotConfig__Password=



{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "WTelegram": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "UserbotConfig": {
    "Enabled": true,
    "SessionPath": "WTelegram.session",
    "MinDelayMs": 2000,
    "MaxDelayMs": 5000,
    "MaxMediaMb": 100,
    "CaptionLimit": 1024,
    "Routes": [
      {
        "RouteName": "Apartments Group A",
        "SourceChannelIds": [ -1001111111111, -1002222222222 ],
        "TargetChannelIds": [ -1003333333333, -1004444444444 ],
        "OnlyWithPhoto": false,
        "RemoveWords": [ "reklama", "admin bilan bog'laning" ],
        "ReplacementText": "\n\n📞 Murojaat uchun: +998901234567\n👉 Kanal: @MeningKanalim",
        "RemoveLinks": true,
        "RemoveUsernames": true,
        "RemovePhones": true,
        "LinkReplacement": "",
        "UsernameReplacement": "",
        "PhoneReplacement": ""
      },
      {
        "RouteName": "Houses Group B",
        "SourceChannelIds": [ -1005555555555 ],
        "TargetChannelIds": [ -1006666666666 ]
      }
    ]
  }
}

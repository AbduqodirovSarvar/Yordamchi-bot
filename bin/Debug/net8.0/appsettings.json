{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "WTelegram": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "BotConfig": {
    "Enabled": true,
    "BotToken": "YOUR_TOKEN",
    "WebhookUrl": "https://bot.mydomain.com/webhook",
    "WebhookSecret": "change-me-random-string",
    "SourceChannelId": -1001234567890,
    "AdminIds": [],
    "TargetChannelIds": [ -1001111111111, -1002222222222 ],
    "RemoveWords": [ "reklama", "admin bilan bog'laning" ],
    "ReplacementText": "\n\n📞 Murojaat uchun: +998901234567\n👉 Bizning kanal: @MyChannel"
  },

  "UserbotConfig": {
    "Enabled": true,
    "ApiId": 123456,
    "ApiHash": "YOUR_API_HASH",
    "PhoneNumber": "+998901234567",
    "Password": "",
    "SessionPath": "WTelegram.session",
    "MinDelayMs": 2000,
    "MaxDelayMs": 5000,
    "MaxMediaMb": 100,
    "CaptionLimit": 1024,
    "RemoveWords": [ "reklama", "admin bilan bog'laning" ],
    "Routes": [
      {
        "Name": "Route 1 - Apartments",
        "SourceChannelIds": [ -1001111111111, -1002222222222 ],
        "TargetChannelIds": [ -1003333333333 ],
        "ReplacementText": "\n\n📞 Murojaat uchun: +998901234567\n👉 Kanal: @MeningKanalim"
      },
      {
        "Name": "Route 2 - Houses",
        "SourceChannelIds": [ -1004444444444 ],
        "TargetChannelIds": [ -1005555555555 ],
        "RemoveWords": [ "uy egasi emas" ],
        "ReplacementText": "\n\n📞 Uy egasi: +998909999999\n👉 @MeningIkkinchiKanalim"
      }
    ]
  }
}
